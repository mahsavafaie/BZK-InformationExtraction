   "source": [
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d1bd1c07",
   "metadata": {},
   "outputs": [],
   "source": [
    "def excel_to_csv(excel_file, csv_file):\n",
    "\n",
    "    # Read the Excel file\n",
    "    df = pd.read_excel(excel_file)\n",
    "    # Calculate the minimum number of non-NA/null entries required per column\n",
    "    min_count = int(0.10 * len(df))\n",
    "    # Filter out columns with fewer non-NA/null entries than the threshold\n",
    "    filtered_df = df.dropna(thresh=min_count, axis=1)\n",
    "    print(df.shape[1],filtered_df.shape[1])\n",
    "    filtered_df.to_csv(csv_file, index=False, encoding= \"utf-8-sig\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e9546d0c",
   "metadata": {},
   "outputs": [],
   "source": [
    "excel_file_path = ".\transcription_BZK.xlsx" \n",
    "csv_file_path =".\transcription_BZK.csv" \n",
    "\n",
    "excel_to_csv(excel_file_path, csv_file_path)\n",
    "print(f\"Excel file {excel_file_path} has been converted to CSV file {csv_file_path}.\")\n",
    "\n"
   ]
  }
 ],
